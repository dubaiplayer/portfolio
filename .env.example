# Copy to .env.local and fill in. .env.local is gitignored by the *.local rule.
# NONE of these may be prefixed VITE_ — that would inline the secret into the
# client bundle where anyone can read it.

# ── Generation ───────────────────────────────────────────────────────────────
# Groq free tier. IMPORTANT: do not add a credit card to this account. With no
# payment method the worst case of endpoint abuse is "chat is down until the
# quota resets" rather than a bill. See api/_lib/guard.js.
# Free tier for gpt-oss-120b: 30 req/min, 1000 req/day, 8000 tokens/min.
# https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ── Embeddings (optional but recommended) ────────────────────────────────────
# Google AI Studio key for gemini-embedding-001, used by `yarn ingest` and by
# the chat function. Without it, retrieval runs BM25-only and still works.
# https://aistudio.google.com/apikey
EMBED_API_KEY=

# ── Abuse protection ─────────────────────────────────────────────────────────
# Comma-separated. Leave empty to disable the check (fine for local dev).
ALLOWED_ORIGINS=http://localhost:5173,https://deveshgupta.vercel.app

# ── Ingest only (never needed on Vercel — ingest doesn't run there) ──────────
# Raises the GitHub API limit from 60/hr to 5000/hr.
GITHUB_TOKEN=
